{% assign cleveland_lat = 41.4993 %}
{% assign cleveland_lon = -81.6944 %}
{% assign event_lat = page.event_lat | plus: 0 %}
{% assign event_lon = page.event_lon | plus: 0 %}

{% if event_lat and event_lon %}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">

  {% assign distance_miles = event_lat | haversine_miles: event_lon, cleveland_lat, cleveland_lon %}
  {% assign map_id = page.url | slugify | prepend: 'event-travel-map-' %}

  <section
    class="event-travel-map"
    style="margin: 1.25rem 0 0; padding: 0.9rem; border: 1px solid #d6d6d6; border-radius: 10px; background: #fafafa; color: #1f2937;"
  >
    <h2 style="margin-top: 0; margin-bottom: 0.35rem; font-size: 1.2rem; color: #111827;">Travel Map</h2>
    <p style="margin: 0 0 0.75rem; color: #1f2937;">
      Cleveland, Ohio to {{ page.event_location }}
      {% if distance_miles %}
        (
        {% if distance_miles < 1 %}
          less than 1 mile
        {% elsif distance_miles == 1 %}
          1 mile
        {% else %}
          {{ distance_miles }} miles
        {% endif %}
        as the Roc flies )
      {% endif %}
    </p>

    <div id="{{ map_id }}" style="width: 100%; height: 320px; border: 1px solid #d9d9d9; border-radius: 8px;"></div>

    <script>
      (function () {
        var mapId = "{{ map_id }}";
        var cleveland = [{{ cleveland_lat }}, {{ cleveland_lon }}];
        var eventCity = [{{ event_lat }}, {{ event_lon }}];
        var maxAttempts = 50;

        function initMap(attempt) {
          var mapEl = document.getElementById(mapId);
          if (!mapEl) return;
          if (mapEl.dataset.mapReady === "true") return;

          if (!window.L) {
            if (attempt < maxAttempts) {
              window.setTimeout(function () {
                initMap(attempt + 1);
              }, 100);
            }
            return;
          }

          mapEl.dataset.mapReady = "true";

          var map = L.map(mapId, { scrollWheelZoom: false });
          L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
          }).addTo(map);

          L.marker(cleveland).addTo(map).bindPopup("Cleveland, Ohio");
          L.marker(eventCity).addTo(map).bindPopup("{{ page.event_location | escape }}");
          L.polyline([cleveland, eventCity], { color: "#1d4ed8", weight: 3, opacity: 0.85 }).addTo(map);
          map.fitBounds([cleveland, eventCity], { padding: [30, 30] });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", function () {
            initMap(0);
          });
        } else {
          initMap(0);
        }
      })();
    </script>

    <p style="margin: 0.65rem 0 0; font-size: 0.95rem; color: #1f2937;">
      <a
        style="color: #0f4da8;"
        href="https://www.openstreetmap.org/directions?engine=fossgis_osrm_car&amp;route={{ cleveland_lat }},{{ cleveland_lon }};{{ event_lat }},{{ event_lon }}"
        target="_blank"
        rel="noopener noreferrer"
        >Open driving route in OpenStreetMap</a
      >
    </p>
  </section>
{% endif %}
